{
  "name": "scan2ebook-reader",
  "version": "0.1.0",
  "type": "module",
  "description": "Local browser reader for page-anchored .s2e ebooks.",
  "license": "MIT",
  "bin": {
    "scan2ebook-reader": "./bin/scan2ebook-reader.js"
  },
  "exports": {
    ".": "./lib/server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node ./bin/scan2ebook-reader.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run pack:check",
    "test": "node --import tsx --test test/*.test.mjs",
    "test:smoke": "node --import tsx test/reader-smoke.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "pack:check": "npm run build && npm run test:package",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
